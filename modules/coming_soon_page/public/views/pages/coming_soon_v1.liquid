layout: modules/coming_soon_page/default
searchable: true
max_deep_level: 1
metadata: {
  page_name: "Insites Coming Soon Page | Version 1",
  page_type: "content",
  page_title: "Insites Coming Soon Page | Version 1",
  meta_title: "Insites Coming Soon Page | Version 1",
  canonical_url: "",
  open_graph_url: "",
  open_graph_type: "",
  meta_description: "Insites Coming Soon Page | Version 1",
  open_graph_title: "Insites Coming Soon Page | Version 1",
  open_graph_site_name: "",
  open_graph_description: "Insites Coming Soon Page | Version 1",
  is_visible_to_search_engines: true,
  is_auth_policy_enabled: false,
}
dynamic_cache:
  layout: true
  key: |-
    {%- parse_json models -%}
    [
      "modules/insites_site_manager/insites_global_content"
    ]
    {%- endparse_json -%}
    {%- include "modules/coming_soon_page/cache/generate_cache_key", models: models -%}
