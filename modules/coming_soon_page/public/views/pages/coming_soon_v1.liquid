{% include "modules/coming_soon_page/data/global_content" %}
{%- assign global = context.exports.global -%}

<div class="coming-soon-v1" >
  <div class="grid-x grid-padding-x">
    <div class="logo-container cell text-center">
      <a href="{{ context.params.slug }}">
        {% if global.company_logo.url != blank %}
          <img class="logo" src="{{ global.company_logo.url }}" 
            alt="Company Logo"   
            width="133" 
            height="auto" >
        {% else %}
          <img class="logo" src="{{ 'modules/coming_soon_page/images/logo/company-logo.png' | asset_url }}" 
            alt="Company Logo"   
            width="133" 
            height="auto" >
        {% endif %}
      </a>
    </div>
    <div class="spacer xx-large"></div>
    <div class="content-container cell text-center">
      {%- include "modules/coming_soon_page/content/coming_soon_card" -%}
    </div>
  </div>
</div>