---
  metadata: {
    partial_name: "project-assets"
  }
---
  
{%- comment -%}
    - Project Assets - Holds app css and js
{%- endcomment -%}

{%- if context.environment == "staging" -%}
    <link rel="preload" as="style" href="{{ 'modules/coming_soon_page/styles/app.css' | asset_url }}" >
    <link rel="stylesheet" href="{{ 'modules/coming_soon_page/styles/app.css' | asset_url }}" > 
    <link rel="preload" as="style" href="{{ 'modules/coming_soon_page/styles/custom.css' | asset_url }}" >
    <link rel="stylesheet" href="{{ 'modules/coming_soon_page/styles/custom.css' | asset_url }}" >
{%- else -%}
    {%- comment -%} Minified version will be used in the production environment {%- endcomment -%}
    <link rel="preload" as="style" href="{{ 'modules/coming_soon_page/styles/app.min.css' | asset_url }}" >
    <link rel="stylesheet" href="{{ 'modules/coming_soon_page/styles/app.min.css' | asset_url }}" >
    <link rel="preload" as="style" href="{{ 'modules/coming_soon_page/styles/custom.min.css' | asset_url }}" >
    <link rel="stylesheet" href="{{ 'modules/coming_soon_page/styles/custom.min.css' | asset_url }}" >
{%- endif -%}